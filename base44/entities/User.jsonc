{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "vip"
      ],
      "default": "user"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "total_invested": {
      "type": "number",
      "default": 0
    },
    "total_earned": {
      "type": "number",
      "default": 0
    },
    "total_deposited": {
      "type": "number",
      "default": 0
    },
    "referral_code": {
      "type": "string"
    },
    "referral_code_used": {
      "type": "string"
    },
    "dni": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "welcome_bonus_claimed": {
      "type": "boolean",
      "default": false
    },
    "ruleta_usada": {
      "type": "boolean",
      "default": false
    }
  }
}