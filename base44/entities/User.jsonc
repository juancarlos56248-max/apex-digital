{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "vip",
        "admin"
      ],
      "default": "user"
    },
    "dni": {
      "type": "string",
      "description": "Documento Nacional de Identidad"
    },
    "phone": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "total_invested": {
      "type": "number",
      "default": 0
    },
    "total_earned": {
      "type": "number",
      "default": 0
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code"
    },
    "referral_code_used": {
      "type": "string",
      "description": "Referral code used at registration"
    },
    "welcome_bonus_claimed": {
      "type": "boolean",
      "default": false,
      "description": "True if the $5 welcome bonus has been credited"
    }
  },
  "required": [
    "dni",
    "phone",
    "referral_code"
  ]
}