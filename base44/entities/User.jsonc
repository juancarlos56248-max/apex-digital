{
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "total_invested": {
      "type": "number",
      "default": 0
    },
    "total_earned": {
      "type": "number",
      "default": 0
    },
    "welcome_bonus_claimed": {
      "type": "boolean",
      "default": false
    },
    "deposit_bonus_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Si el usuario ya recibi\u00f3 la bonificaci\u00f3n \u00fanica del 50% por dep\u00f3sito"
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by": {
      "type": "string"
    },
    "two_fa_pin": {
      "type": "string"
    },
    "two_fa_expires": {
      "type": "string"
    },
    "tier_ranges": {
      "type": "object",
      "description": "Rangos personalizados por plan: { starter: { min, max }, advance: { min, max }, ... }"
    },
    "dni": {
      "type": "string",
      "description": "Documento de identidad"
    },
    "phone": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono"
    },
    "kyc_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
