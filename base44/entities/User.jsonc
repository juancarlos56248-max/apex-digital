    },
    "dni_photo_uri": {
      "type": "string",
      "description": "URI privada de la foto del DNI"
    },
    "kyc_selfie_uri": {
      "type": "string",
      "description": "URI privada de la selfie con DNI"
    },
    "bono_codigo_activado": {
      "type": "boolean",
      "default": false,
      "description": "Si el usuario ya activ\u00f3 su c\u00f3digo de bono especial"
    }
  },
  "name": "User"
}